# Application
APP_NAME=MeetingSum
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=your-secret-key-here

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./meetingsum.db

# Redis
REDIS_URL=redis://localhost:6379

# Speech Recognition
ASR_PROVIDER=whisper_local
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu

# LLM
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# File limits
MAX_FILE_SIZE_MB=2048
MAX_VIDEO_DURATION_SECONDS=14400
ALLOWED_FORMATS=mp4,mov,avi,mkv,mp3,wav,m4a,webm

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
